@{
    ViewData["Title"] = "Dashboard";
    var topPaths = ViewBag.TopPaths as IReadOnlyList<KeyValuePair<string, long>> ?? Array.Empty<KeyValuePair<string, long>>();
}

<h2>Panel administracyjny – Dashboard</h2>

<div class="row g-3 my-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Łączna liczba żądań</h6>
                <p class="display-6 mb-0">@ViewBag.TotalRequests</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Książki w pamięci</h6>
                <p class="display-6 mb-0">@ViewBag.BooksCount</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h6 class="card-subtitle text-muted">Autorzy w pamięci</h6>
                <p class="display-6 mb-0">@ViewBag.AuthorsCount</p>
            </div>
        </div>
    </div>
</div>

<h4 class="mt-4">5 najpopularniejszych ścieżek</h4>
@if (topPaths.Count == 0)
{
    <p class="text-muted">Brak zarejestrowanych żądań.</p>
}
else
{
    <table class="table table-striped bg-white">
        <thead>
            <tr>
                <th>#</th>
                <th>Ścieżka</th>
                <th>Liczba żądań</th>
            </tr>
        </thead>
        <tbody>
            @for (int i = 0; i < topPaths.Count; i++)
            {
                <tr>
                    <td>@(i + 1)</td>
                    <td><code>@topPaths[i].Key</code></td>
                    <td>@topPaths[i].Value</td>
                </tr>
            }
        </tbody>
    </table>
}

<div class="mt-3">
    <a class="btn btn-primary" asp-area="Admin" asp-controller="Authors" asp-action="Index">Zarządzaj autorami</a>
    <a class="btn btn-outline-secondary" asp-area="" asp-controller="Home" asp-action="Index">Strona główna</a>
</div>
