@model Book
@{ ViewData["Title"] = "Usuń książkę"; }

<h2 class="text-danger">Czy na pewno chcesz usunąć tę książkę?</h2>

<dl class="row mt-3">
    <dt class="col-sm-2">Tytuł</dt><dd class="col-sm-10">@Model.Title</dd>
    <dt class="col-sm-2">Autor</dt><dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">ISBN</dt><dd class="col-sm-10">@Model.Isbn</dd>
    <dt class="col-sm-2">Cena</dt><dd class="col-sm-10">@Model.Price.ToString("C")</dd>
</dl>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>
