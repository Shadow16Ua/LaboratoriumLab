@model Book
@{ ViewData["Title"] = Model.Title; }

<h2>@Model.Title</h2>
<dl class="row">
    <dt class="col-sm-2">Autor</dt><dd class="col-sm-10">@Model.Author</dd>
    <dt class="col-sm-2">ISBN</dt><dd class="col-sm-10">@Model.Isbn</dd>
    <dt class="col-sm-2">Data wydania</dt><dd class="col-sm-10">@Model.PublicationDate?.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-2">Liczba stron</dt><dd class="col-sm-10">@Model.NumPages</dd>
    <dt class="col-sm-2">Cena</dt><dd class="col-sm-10">@Model.Price.ToString("C")</dd>
</dl>
<a asp-action="Index" class="btn btn-secondary">Wróć</a>
