@{ ViewData["Title"] = "Start"; }

<div class="p-4 mb-4 bg-light rounded">
    <h1>BookStore</h1>
    <p class="lead">Aplikacja ćwiczeniowa: ASP.NET Core MVC (Lab 1–3: routing, middleware, filtry, obszary, strony błędów).</p>
    <a class="btn btn-primary" asp-area="" asp-controller="Book" asp-action="Index">Przeglądaj książki</a>
    <a class="btn btn-outline-secondary" asp-area="" asp-controller="Book" asp-action="Create">Dodaj książkę</a>
    <a class="btn btn-outline-danger" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Panel Admina</a>
</div>

<h4>Adresy do wypróbowania (Lab 1–3)</h4>
<ul>
    <li><a href="/books/year/1961">/books/year/1961</a> – książki z 1961 r. (ograniczenie <code>int:min(1450)</code>)</li>
    <li><a href="/books/isbn/9788308065341">/books/isbn/9788308065341</a> – przekierowanie po ISBN (regex 13 cyfr)</li>
    <li><a href="/archive/1965/05">/archive/1965/05</a> – archiwum rok/miesiąc (<code>range(1,12)</code>)</li>
    <li><a href="/docs/a/b/c">/docs/a/b/c</a> – catch-all <code>{*path}</code></li>
    <li><a href="/Home/Routes">/Home/Routes</a> – tabela wszystkich tras</li>
    <li><a href="/Admin">/Admin</a> – obszar Admin (Dashboard + Autorzy)</li>
    <li><a href="/blokada">/blokada</a> – short-circuit w middleware (403)</li>
    <li><a href="/nie-ma-takiej-strony">/nie-ma-takiej-strony</a> – strona błędu 404</li>
    <li><a href="/Book/Boom">/Book/Boom</a> – wyjątek obsłużony przez <code>GlobalExceptionFilter</code> (500)</li>
    <li><a href="/Book/Status?code=418">/Book/Status?code=418</a> – kod 418 ze stroną statusu</li>
</ul>
