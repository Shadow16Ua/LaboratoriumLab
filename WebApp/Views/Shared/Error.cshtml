@model ErrorViewModel
@{ ViewData["Title"] = "Błąd 500"; }

<h1 class="text-danger">500 – coś poszło nie tak</h1>
<p>Wystąpił nieoczekiwany błąd. Został zapisany w dzienniku serwera.</p>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert alert-warning"><strong>Szczegóły (tylko Development):</strong> @Model.Message</div>
}
@if (Model.ShowRequestId)
{
    <p class="text-muted">Identyfikator żądania: <code>@Model.RequestId</code></p>
}
<a asp-controller="Home" asp-action="Index" class="btn btn-primary">Strona główna</a>
